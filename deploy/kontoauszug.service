[Unit]
Description=Kontoauszug zu CSV
After=network-online.target

[Service]
User=kontoauszug
Group=kontoauszug
WorkingDirectory=/opt/kontoauszug/app
EnvironmentFile=/etc/kontoauszug.env
ExecStart=/opt/kontoauszug/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --proxy-headers --timeout-keep-alive 30
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/kontoauszug

[Install]
WantedBy=multi-user.target
